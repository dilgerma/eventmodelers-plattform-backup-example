st mr-1\"></i>\n                                43 tasks\n                            </span>\n                            <span>\n                                <i class=\"fas fa-users mr-1\"></i>\n                                Team\n                            </span>\n                            <span>\n                                <i class=\"fas fa-circle has-text-success mr-1\"></i>\n                                Active\n                            </span>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div>\n\n    </main>\n</div>\n\n</body>\n</html>",
      "<div class=\"modal is-active\">\n    <div class=\"modal-background\"></div>\n\n    <div class=\"modal-card\">\n        <header class=\"modal-card-head\">\n            <p class=\"modal-card-title\">Create TODO List</p>\n\n            <button class=\"delete\" aria-label=\"close\"></button>\n        </header>\n\n        <section class=\"modal-card-body\">\n\n            <div class=\"field\">\n                <label class=\"label\">Name</label>\n                <div class=\"control\">\n                    <input class=\"input\" type=\"text\" placeholder=\"e.g. Work Tasks\" autofocus />\n                </div>\n                <p class=\"help\">\n                    Choose a name that describes what this list is used for.\n                </p>\n            </div>\n\n            <div class=\"field\">\n                <label class=\"label\">Description</label>\n                <div class=\"control\">\n                    <textarea class=\"textarea\" placeholder=\"What is this TODO list for?\"></textarea>\n                </div>\n            </div>\n\n            <div class=\"field\">\n                <label class=\"label\">Visibility</label>\n\n                <div class=\"control\">\n                    <label class=\"radio\">\n                        <input type=\"radio\" name=\"visibility\" checked />\n                        Private\n                    </label>\n\n                    <label class=\"radio ml-4\">\n                        <input type=\"radio\" name=\"visibility\" />\n                        Shared with team\n                    </label>\n                </div>\n            </div>\n\n        </section>\n\n        <footer class=\"modal-card-foot\">\n            <button class=\"button is-primary\">\n                Create TODO List\n            </button>\n\n            <button class=\"button\">\n                Cancel\n            </button>\n        </footer>\n    </div>\n</div>"
