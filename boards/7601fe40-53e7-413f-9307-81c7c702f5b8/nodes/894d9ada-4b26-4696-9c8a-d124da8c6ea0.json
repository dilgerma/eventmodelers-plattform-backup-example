      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>TODO Lists</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css\" />\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.4/css/all.min.css\" />\n\n    <style>\n        body {\n            background: #f7f8fa;\n        }\n\n        .sidebar {\n            min-height: 100vh;\n            background: #fff;\n            border-right: 1px solid #e5e7eb;\n        }\n\n        .sidebar .menu-label {\n            padding-left: 1.25rem;\n            padding-top: 1.5rem;\n        }\n\n        .sidebar .menu-list a {\n            padding: 0.75rem 1.25rem;\n        }\n\n        .main {\n            padding: 2.5rem 3rem;\n        }\n\n        .page-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 2rem;\n        }\n\n        .list-card {\n            background: white;\n            border: 1px solid #e5e7eb;\n            border-radius: 6px;\n            transition: box-shadow 0.15s ease;\n        }\n\n        .list-card:hover {\n            box-shadow: 0 4px 14px rgba(0,0,0,.06);\n        }\n\n        .list-card-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 1.25rem 1.5rem;\n            border-bottom: 1px solid #eee;\n        }\n\n        .list-card-body {\n            padding: 1.25rem 1.5rem;\n        }\n\n        .list-name {\n            font-size: 1.1rem;\n            font-weight: 600;\n        }\n\n        .list-description {\n            color: #6b7280;\n            font-size: .9rem;\n            margin-top: .25rem;\n        }\n\n        .list-meta {\n            display: flex;\n            gap: 1.5rem;\n            color: #6b7280;\n            font-size: .85rem;\n        }\n\n        .empty-icon {\n            width: 64px;\n            height: 64px;\n            border-radius: 50%;\n            background: #f1f5f9;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto 1rem;\n            color: #64748b;\n        }\n    </style>\n</head>\n\n<body>\n\n<div class=\"columns is-gapless\">\n\n    \n    <aside class=\"column is-2 sidebar\">\n        <div class=\"p-5\">\n            <p class=\"title is-5 mb-1\">Todo Manager</p>\n            <p class=\"is-size-7 has-text-grey\">Configuration</p>\n        </div>\n\n        <aside class=\"menu\">\n            <p class=\"menu-label\">Workspace</p>\n            <ul class=\"menu-list\">\n                <li>\n                    <a class=\"is-active\">\n                        <span class=\"icon is-small mr-2\">\n                            <i class=\"fas fa-list-check\"></i>\n                        </span>\n                        TODO Lists\n                    </a>\n                </li>\n                <li>\n                    <a>\n                        <span class=\"icon is-small mr-2\">\n                            <i class=\"fas fa-users\"></i>\n                        </span>\n                        Users\n                    </a>\n                </li>\n                <li>\n                    <a>\n                        <span class=\"icon is-small mr-2\">\n                            <i class=\"fas fa-cog\"></i>\n                        </span>\n                        Settings\n                    </a>\n                </li>\n            </ul>\n        </aside>\n    </aside>\n\n    \n    <main class=\"column main\">\n\n        <div class=\"page-header\">\n            <div>\n                <h1 class=\"title is-3 mb-2\">TODO Lists</h1>\n                <p class=\"subtitle is-6 has-text-grey\">\n                    Configure and manage your TODO lists\n                </p>\n            </div>\n\n            <button class=\"button is-primary\">\n                <span class=\"icon\">\n                    <i class=\"fas fa-plus\"></i>\n                </span>\n                <span>New TODO List</span>\n            </button>\n        </div>\n\n        \n        <div class=\"box mb-5\">\n            <div class=\"columns is-vcentered\">\n                <div class=\"column\">\n                    <div class=\"field has-addons\">\n                        <div class=\"control has-icons-left is-expanded\">\n                            <input class=\"input\" type=\"text\" placeholder=\"Search TODO lists...\" />\n                            <span class=\"icon is-small is-left\">\n                                <i class=\"fas fa-search\"></i>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"column is-narrow\">\n                    <div class=\"select\">\n                        <select>\n                            <option>All lists</option>\n                            <option>Active</option>\n                            <option>Archived</option>\n                        </select>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"columns is-multiline\">\n\n            <div class=\"column is-6\">\n                <div class=\"list-card\">\n\n                    <div class=\"list-card-header\">\n                        <div>\n                            <div class=\"list-name\">Personal Tasks</div>\n                            <div class=\"list-description\">\n                                Personal tasks and reminders\n                            </div>\n                        </div>\n\n                        <div class=\"dropdown is-right is-hoverable\">\n                            <div class=\"dropdown-trigger\">\n                                <button class=\"button is-white\">\n                                    <span class=\"icon\">\n                     