      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>Create Account</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css\" />\n\n    <style>\n        html, body {\n            background: #f5f7fa;\n            height: 100%;\n        }\n\n        .hero {\n            min-height: 100vh;\n        }\n\n        .register-card {\n            max-width: 520px;\n            margin: auto;\n        }\n\n        .card {\n            border-radius: 12px;\n        }\n\n        .logo {\n            font-size: 3rem;\n        }\n    </style>\n</head>\n<body>\n\n<section class=\"hero is-fullheight\">\n    <div class=\"hero-body\">\n        <div class=\"container\">\n\n            <div class=\"register-card\">\n\n                <div class=\"has-text-centered mb-5\">\n                    <div class=\"logo\">📚</div>\n                    <h1 class=\"title\">Create Account</h1>\n                    <p class=\"subtitle\">\n                        Register to start managing your books.\n                    </p>\n                </div>\n\n                <div class=\"card\">\n                    <div class=\"card-content\">\n\n                        <div class=\"field\">\n                            <label class=\"label\">Full Name</label>\n                            <div class=\"control\">\n                                <input class=\"input\" type=\"text\" placeholder=\"John Doe\" />\n                            </div>\n                        </div>\n\n                        <div class=\"field\">\n                            <label class=\"label\">Email</label>\n                            <div class=\"control\">\n                                <input class=\"input\" type=\"email\" placeholder=\"john@example.com\" />\n                            </div>\n                        </div>\n\n                        <div class=\"field\">\n                            <label class=\"label\">Company</label>\n                            <div class=\"control\">\n                                <input class=\"input\" type=\"text\" placeholder=\"Acme Inc.\" />\n                            </div>\n                        </div>\n\n                        <div class=\"columns\">\n                            <div class=\"column\">\n                                <div class=\"field\">\n                                    <label class=\"label\">Password</label>\n                                    <div class=\"control\">\n                                        <input class=\"input\" type=\"password\" />\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class=\"column\">\n                                <div class=\"field\">\n                                    <label class=\"label\">Repeat Password</label>\n                                    <div class=\"control\">\n                                        <input class=\"input\" type=\"password\" />\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"field\">\n                            <label class=\"checkbox\">\n                                <input type=\"checkbox\" />\n                                I accept the Terms of Service and Privacy Policy\n                            </label>\n                        </div>\n\n                        <div class=\"field mt-5\">\n                            <button class=\"button is-primary is-fullwidth\">\n                                Create Account\n                            </button>\n                        </div>\n\n                    </div>\n                </div>\n\n                <p class=\"has-text-centered mt-4\">\n                    Already have an account?\n                    <a href=\"#\">Sign in</a>\n                </p>\n\n            </div>\n\n        </div>\n    </div>\n</section>\n\n</body>\n</html>",
      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>Registration Complete</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css\" />\n\n    <style>\n        html, body {\n            background: #f5f7fa;\n            height: 100%;\n        }\n\n        .hero {\n            min-height: 100vh;\n        }\n\n        .confirmation-card {\n            max-width: 560px;\n            margin: auto;\n        }\n\n        .card {\n            border-radius: 12px;\n        }\n\n        .success-icon {\n            font-size: 4rem;\n        }\n    </style>\n</head>\n<body>\n\n<section class=\"hero is-fullheight\">\n    <div class=\"hero-body\">\n        <div class=\"container\">\n\n            <div class=\"confirmation-card\">\n\n                <div class=\"card\">\n                    <div class=\"card-content has-text-centered\">\n\n                        <div class=\"success-icon mb-4\">\n                            ✅\n                        </div>\n\n                        <h1 class=\"title\">\n                            Registration Successful\n                        </h1>\n\n                        <p class=\"subtitle\">\n                            Thank you for creating your account.\n                        </p>\n\n                        <div class=\"notification is-light\">\n                            A confirmation email has been sent to\n                            <strong>john@example.com</strong>.\n                            <br /><br />\n                            Please click the verification link before signing in.\n                        </div>\n\n                        <div class=\"content\">\n                            <p>\n                                Didn't receive the email?\n                            </p>\n\n                            <div class=\"buttons is-centered mt-4\">\n                                <button class=\"button is-primary\">\n                                    Resend Verification Email\n                                </button>\n\n                                <button class=\"button is-light\">\n                                    Change Email Address\n                                </button>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n\n                <div class=\"has-text-centered mt-5\">\n                    <a class=\"button is-link is-light\">\n                        Return to Sign In\n                    </a>\n                </div>\n\n            </div>\n\n        </div>\n    </div>\n</section>\n\n</body>\n</html>"
