    "pages": [
      "\n<html lang=\"en\">\n<head>\n\n\n<title>Sign In</title>\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link href=\"https://fonts.googleapis.com/css2?family=Amazon+Ember:wght@400;500;700&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\" />\n\n<style>\n* {\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nbody {\n    font-family: Inter, Arial, sans-serif;\n    background:#fff;\n    color:#111;\n}\n\n.container {\n    width:100%;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding-top:35px;\n}\n\n.logo {\n    font-size:34px;\n    font-weight:700;\n    letter-spacing:-1px;\n    margin-bottom:28px;\n    user-select:none;\n}\n\n.logo span {\n    color:#ff9900;\n}\n\n.card {\n    width:350px;\n    border:1px solid #ddd;\n    border-radius:8px;\n    padding:28px 26px;\n    background:white;\n}\n\nh1 {\n    font-size:28px;\n    font-weight:500;\n    margin-bottom:20px;\n}\n\nlabel {\n    display:block;\n    font-size:14px;\n    font-weight:700;\n    margin-bottom:7px;\n}\n\ninput {\n    width:100%;\n    height:40px;\n    padding:0 10px;\n    border:1px solid #888;\n    border-radius:4px;\n    font-size:15px;\n    margin-bottom:18px;\n}\n\ninput:focus {\n    outline:none;\n    border-color:#007185;\n    box-shadow:0 0 0 3px rgba(0,113,133,.18);\n}\n\n.password-row {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n}\n\n.password-row a {\n    font-size:13px;\n    color:#0066c0;\n    text-decoration:none;\n}\n\n.password-row a:hover {\n    text-decoration:underline;\n}\n\nbutton {\n    width:100%;\n    height:38px;\n    border:none;\n    border-radius:20px;\n    background:#FFD814;\n    cursor:pointer;\n    font-size:14px;\n}\n\nbutton:hover {\n    background:#F7CA00;\n}\n\n.disclaimer {\n    margin-top:18px;\n    font-size:12px;\n    line-height:1.5;\n}\n\n.disclaimer a,\n.help a {\n    color:#0066c0;\n    text-decoration:none;\n}\n\n.help {\n    margin-top:20px;\n    font-size:13px;\n}\n\n.separator {\n    width:350px;\n    display:flex;\n    align-items:center;\n    color:#777;\n    margin:26px 0 18px;\n    font-size:12px;\n}\n\n.separator::before,\n.separator::after {\n    content:\"\";\n    flex:1;\n    height:1px;\n    background:#ddd;\n}\n\n.separator span {\n    margin:0 12px;\n}\n\n.create {\n    width:350px;\n    height:36px;\n    border:1px solid #ccc;\n    background:#fff;\n    border-radius:20px;\n    cursor:pointer;\n}\n\n.create:hover {\n    background:#f7f7f7;\n}\n\nfooter {\n    margin-top:60px;\n    width:100%;\n    border-top:1px solid #eee;\n    text-align:center;\n    padding:28px;\n    font-size:12px;\n    color:#666;\n}\n\nfooter a {\n    margin:0 10px;\n    color:#0066c0;\n    text-decoration:none;\n}\n\n@media(max-width:420px){\n\n.card,\n.separator,\n.create{\n    width:92%;\n}\n\n}\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n\n    <div class=\"logo\">\n        amaz<span>on</span>\n    </div>\n\n    <div class=\"card\">\n\n        <h1>Sign in</h1>\n\n        <label>Email or mobile phone number</label>\n        <input type=\"email\" />\n\n        <div class=\"password-row\">\n            <label>Password</label>\n            <a href=\"#\">Forgot password?</a>\n        </div>\n\n        <input type=\"password\" />\n\n        <button>Sign in</button>\n\n        <div class=\"disclaimer\">\n            By continuing, you agree to the\n            <a href=\"#\">Terms of Use</a>\n            and\n            <a href=\"#\">Privacy Notice</a>.\n        </div>\n\n        <div class=\"help\">\n            ▶ <a href=\"#\">Need help?</a>\n        </div>\n\n    </div>\n\n    <div class=\"separator\">\n        <span>New to Amazon?</span>\n    </div>\n\n    <button class=\"create\">\n        Create your Amazon account\n    </button>\n\n</div>\n\n<footer>\n    <a href=\"#\">Conditions of Use</a>\n    <a href=\"#\">Privacy Notice</a>\n    <a href=\"#\">Help</a>\n\n    <div style=\"margin-top:12px\">\n        © 1996–2026, Amazon.com, Inc. or its affiliates\n    </div>\n</footer>\n\n</body>\n</html>",
      "\n<html lang=\"en\">\n<head>\n\n\n<title>Registration Complete</title>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\" />\n\n<style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nbody{\n    font-family:Inter,Arial,sans-serif;\n    background:#ffffff;\n    color:#111;\n}\n\n.wrapper{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding:40px 20px;\n}\n\n.logo{\n    font-size:34px;\n    font-weight:700;\n    margin-bottom:28px;\n    letter-spacing:-1px;\n}\n\n.logo span{\n    color:#ff9900;\n}\n\n.card{\n    width:420px;\n    border:1px solid #ddd;\n    border-radius:8px;\n    background:white;\n    padding:34px;\n}\n\n.icon{\n    width:64px;\n    height:64px;\n    border-radius:50%;\n    background:#067d62;\n    color:white;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:34px;\n    margin:0 auto 24px;\n}\n\nh1{\n    text-align:center;\n    font-size:28px;\n    font-weight:600;\n    margin-bottom:16px;\n}\n\np{\n    color:#555;\n    line-height:1.6;\n    text-align:center;\n    margin-bottom:18px;\n}\n\n.notice{\n    background:#f7f8f8;\n    border-left:4px solid #ff9900;\n    padding:16px;\n    border-radius:4px;\n    font-size:14px;\n    color:#444;\n    margin:25px 0;\n}\n\n.button{\n    display:block;\n    width:100%;\n    height:42px;\n    border:none;\n    border-radius:22px;\n    background:#FFD814;\n    font-size:15px;\n    cursor:pointer;\n}\n\n.button:hover{\n    background:#F7CA00;\n}\n\n.footer{\n    margin-top:60px;\n    text-align:center;\n    color:#666;\n    font-size:12px;\n}\n\n.footer a{\n    color:#0066c0;\n    text-decoration:none;\n    margin:0 10px;\n}\n\n@media(max-width:500px){\n\n.card{\n    width:100%;\n}\n\n}\n</style>\n</head>\n<body>\n\n<div class=\"wrapper\">\n\n    <div class=\"logo\">\n        amaz<span>on</span>\n    </div>\n\n    <div class=\"card\">\n\n        <div class=\"icon\">\n            ✓\n        </div>\n\n        <h1>Registration Complete</h1>\n\n        <p>\n            Your account has been created successfully.\n        </p>\n\n        <p>\n            We've sent a confirmation email to\n            <strong>john.doe@example.com</strong>.\n            Please verify your email address before signing in.\n        </p>\n\n        <div class=\"notice\">\n            <strong>Didn't receive the email?</strong><br /><br />\n            Check your spam folder or request another verification email from the sign-in page.\n        </div>\n\n        <button class=\"button\">\n            Continue to Sign In\n        </button>\n\n    </div>\n\n    <div class=\"footer\">\n        <a href=\"#\">Conditions of Use</a>\n        <a href=\"#\">Privacy Notice</a>\n        <a href=\"#\">Help</a>\n\n        <div style=\"margin-top:12px\">\n            © 1996–2026, Amazon.com, Inc. or its affiliates\n        </div>\n    </div>\n\n</div>\n\n</body>\n</html>",
      "\n<html lang=\"en\">\n<head>\n\n\n<title>Registration Error</title>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\" />\n\n<style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nbody{\n    font-family:Inter,Arial,sans-serif;\n    background:#ffffff;\n    color:#111;\n}\n\n.wrapper{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding:40px 20px;\n}\n\n.logo{\n    font-size:34px;\n    font-weight:700;\n    margin-bottom:28px;\n    letter-spacing:-1px;\n}\n\n.logo span{\n    color:#ff9900;\n}\n\n.card{\n    width:420px;\n    border:1px solid #ddd;\n    border-radius:8px;\n    background:#fff;\n    padding:34px;\n}\n\n.error-icon{\n    width:64px;\n    height:64px;\n    margin:0 auto 24px;\n    border-radius:50%;\n    background:#B12704;\n    color:#fff;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:34px;\n    font-weight:bold;\n}\n\nh1{\n    text-align:center;\n    font-size:28px;\n    font-weight:600;\n    margin-bottom:18px;\n}\n\n.message{\n    text-align:center;\n    color:#555;\n    line-height:1.6;\n    margin-bottom:25px;\n}\n\n.alert{\n    background:#FFF3F3;\n    border:1px solid #E3A5A5;\n    border-left:5px solid #B12704;\n    border-radius:6px;\n    padding:16px;\n    margin-bottom:28px;\n}\n\n.alert strong{\n    display:block;\n    margin-bottom:8px;\n    color:#B12704;\n}\n\n.alert p{\n    color:#444;\n    line-height:1.5;\n}\n\n.button-primary{\n    width:100%;\n    height:42px;\n    border:none;\n    border-radius:22px;\n    background:#FFD814;\n    font-size:15px;\n    cursor:pointer;\n    margin-bottom:12px;\n}\n\n.button-primary:hover{\n    background:#F7CA00;\n}\n\n.button-secondary{\n    width:100%;\n    height:42px;\n    border:1px solid #ccc;\n    border-radius:22px;\n    background:#fff;\n    cursor:pointer;\n    font-size:15px;\n}\n\n.button-secondary:hover{\n    background:#f7f7f7;\n}\n\n.footer{\n    margin-top:60px;\n    text-align:center;\n    font-size:12px;\n    color:#666;\n}\n\n.footer a{\n    color:#0066c0;\n    text-decoration:none;\n    margin:0 10px;\n}\n\n@media(max-width:500px){\n.card{\n    width:100%;\n}\n}\n</style>\n</head>\n<body>\n\n<div class=\"wrapper\">\n\n    <div class=\"logo\">\n        amaz<span>on</span>\n    </div>\n\n    <div class=\"card\">\n\n        <div class=\"error-icon\">!</div>\n\n        <h1>Registration failed</h1>\n\n        <div class=\"message\">\n            We couldn't create your account.\n        </div>\n\n        <div class=\"alert\">\n            <strong>Email address already in use</strong>\n            <p>\n                The email address\n                <strong>john.doe@example.com</strong>\n                is already associated with an Amazon account.\n            </p>\n            <br />\n            <p>\n                Sign in using this email address, or use a different email to create a new account.\n            </p>\n        </div>\n\n        <button class=\"button-primary\">\n            Sign In Instead\n        </button>\n\n        <button class=\"button-secondary\">\n            Use a Different Email\n        </button>\n\n    </div>\n\n    <div class=\"footer\">\n        <a href=\"#\">Conditions of Use</a>\n        <a href=\"#\">Privacy Notice</a>\n        <a href=\"#\">Help</a>\n\n        <div style=\"margin-top:12px\">\n            © 1996–2026, Amazon.com, Inc. or its affiliates\n        </div>\n    </div>\n\n</div>\n\n</body>\n</html>"
