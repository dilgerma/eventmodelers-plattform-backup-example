      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>Create Account</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css\" />\n\n    <style>\n        html, body {\n            height: 100%;\n        }\n\n        body {\n            background:\n                radial-gradient(circle at top left,#7c3aed 0%,transparent 40%),\n                radial-gradient(circle at bottom right,#2563eb 0%,transparent 40%),\n                linear-gradient(135deg,#0f172a,#111827,#1e293b);\n        }\n\n        .register-card {\n            width: 430px;\n            border-radius: 24px;\n            backdrop-filter: blur(18px);\n            background: rgba(255,255,255,.08);\n            border: 1px solid rgba(255,255,255,.15);\n            box-shadow:\n                0 25px 60px rgba(0,0,0,.35);\n        }\n\n        .title {\n            color: white;\n        }\n\n        .subtitle {\n            color: rgba(255,255,255,.7);\n        }\n\n        .label {\n            color: rgba(255,255,255,.85);\n        }\n\n        .input {\n            background: rgba(255,255,255,.08);\n            border: 1px solid rgba(255,255,255,.15);\n            color: white;\n            box-shadow: none;\n            height: 48px;\n        }\n\n        .input::placeholder {\n            color: rgba(255,255,255,.45);\n        }\n\n        .input:focus {\n            border-color: #8b5cf6;\n            box-shadow: 0 0 0 3px rgba(139,92,246,.25);\n        }\n\n        .button.is-gradient {\n            background: linear-gradient(90deg,#7c3aed,#3b82f6);\n            color: white;\n            border: none;\n            height: 50px;\n            font-weight: 700;\n            transition: .25s;\n        }\n\n        .button.is-gradient:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 15px 35px rgba(59,130,246,.4);\n        }\n\n        a {\n            color: #93c5fd;\n        }\n\n        .divider {\n            display: flex;\n            align-items: center;\n            color: rgba(255,255,255,.5);\n            margin: 1.5rem 0;\n        }\n\n        .divider::before,\n        .divider::after {\n            content: \"\";\n            flex: 1;\n            height: 1px;\n            background: rgba(255,255,255,.15);\n        }\n\n        .divider span {\n            padding: 0 1rem;\n        }\n\n        .social-button {\n            background: rgba(255,255,255,.08);\n            border: 1px solid rgba(255,255,255,.15);\n            color: white;\n        }\n\n        .social-button:hover {\n            background: rgba(255,255,255,.15);\n        }\n\n    </style>\n</head>\n\n<body>\n\n<section class=\"hero is-fullheight\">\n    <div class=\"hero-body\">\n\n        <div class=\"container is-flex is-justify-content-center\">\n\n            <div class=\"card register-card\">\n                <div class=\"card-content p-6\">\n\n                    <h1 class=\"title is-2 has-text-centered\">\n                        Create Account\n                    </h1>\n\n                    <p class=\"subtitle has-text-centered mb-6\">\n                        Join thousands building amazing products.\n                    </p>\n\n                    <div class=\"field\">\n                        <label class=\"label\">Full Name</label>\n                        <div class=\"control\">\n                            <input class=\"input\" type=\"text\" placeholder=\"Jane Doe\" />\n                        </div>\n                    </div>\n\n                    <div class=\"field\">\n                        <label class=\"label\">Email</label>\n                        <div class=\"control\">\n                            <input class=\"input\" type=\"email\" placeholder=\"jane@example.com\" />\n                        </div>\n                    </div>\n\n                    <div class=\"field\">\n                        <label class=\"label\">Password</label>\n                        <div class=\"control\">\n                            <input class=\"input\" type=\"password\" placeholder=\"••••••••\" />\n                        </div>\n                    </div>\n\n                    <div class=\"field\">\n                        <label class=\"checkbox has-text-white\">\n                            <input type=\"checkbox\" />\n                            I agree to the Terms &amp; Privacy Policy\n                        </label>\n                    </div>\n\n                    <button class=\"button is-gradient is-fullwidth is-large mt-5\">\n                        Create Free Account\n                    </button>\n\n                    <div class=\"divider\">\n                        <span>OR</span>\n                    </div>\n\n                    <div class=\"buttons\">\n                        <button class=\"button social-button is-fullwidth\">\n                            Continue with Google\n                        </button>\n\n                        <button class=\"button social-button is-fullwidth\">\n                            Continue with GitHub\n                        </button>\n                    </div>\n\n                    <p class=\"has-text-centered mt-5 has-text-white\">\n                        Already have an account?\n                        <a href=\"#\">Sign in</a>\n                    </p>\n\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n</section>\n\n</body>\n</html>",
      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>Registration Successful</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css\" />\n\n    <style>\n        html, body {\n            height: 100%;\n        }\n\n        body {\n            background:\n                radial-gradient(circle at top left,#7c3aed 0%,transparent 40%),\n                radial-gradient(circle at bottom right,#2563eb 0%,transparent 40%),\n                linear-gradient(135deg,#0f172a,#111827,#1e293b);\n        }\n\n        .confirmation-card {\n            width: 500px;\n            border-radius: 24px;\n            backdrop-filter: blur(18px);\n            background: rgba(255,255,255,.08);\n            border: 1px solid rgba(255,255,255,.15);\n            box-shadow: 0 25px 60px rgba(0,0,0,.35);\n        }\n\n        .success-icon {\n            width: 90px;\n            height: 90px;\n            margin: auto;\n            border-radius: 50%;\n            background: linear-gradient(135deg,#22c55e,#16a34a);\n            color: white;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 42px;\n            font-weight: bold;\n            box-shadow: 0 10px 30px rgba(34,197,94,.35);\n        }\n\n        .title {\n            color: white;\n        }\n\n        .subtitle {\n            color: rgba(255,255,255,.75);\n            line-height: 1.6;\n        }\n\n        .notification {\n            background: rgba(59,130,246,.15);\n            border: 1px solid rgba(59,130,246,.35);\n            color: white;\n        }\n\n        .button.is-gradient {\n            background: linear-gradient(90deg,#7c3aed,#3b82f6);\n            color: white;\n            border: none;\n            font-weight: 700;\n            height: 48px;\n        }\n\n        .button.is-gradient:hover {\n            transform: translateY(-2px);\n        }\n\n        a {\n            color: #93c5fd;\n        }\n\n    </style>\n</head>\n\n<body>\n\n<section class=\"hero is-fullheight\">\n    <div class=\"hero-body\">\n\n        <div class=\"container is-flex is-justify-content-center\">\n\n            <div class=\"card confirmation-card\">\n                <div class=\"card-content has-text-centered p-6\">\n\n                    <div class=\"success-icon\">\n                        ✓\n                    </div>\n\n                    <h1 class=\"title is-2 mt-5\">\n                        You're Almost There!\n                    </h1>\n\n                    <p class=\"subtitle mt-4\">\n                        Your account has been created successfully.\n                        We've sent a verification email to\n                        <strong style=\"color:white\">john@example.com</strong>.\n                    </p>\n\n                    <div class=\"notification mt-5 has-text-left\">\n                        <strong>Next steps</strong>\n\n                        <ul class=\"mt-3\">\n                            <li>✓ Open your inbox</li>\n                            <li>✓ Click the verification link</li>\n                            <li>✓ Return here and sign in</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"buttons mt-6\">\n                        <button class=\"button is-gradient is-fullwidth\">\n                            Open Sign In\n                        </button>\n\n                        <button class=\"button is-fullwidth is-light\">\n                            Resend Verification Email\n                        </button>\n                    </div>\n\n                    <p class=\"mt-5 has-text-white\">\n                        Didn't receive anything?\n                        <a href=\"#\">Check your spam folder</a>\n                        or resend the email.\n                    </p>\n\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n</section>\n\n</body>\n</html>",
      "\n<html lang=\"en\">\n<head>\n    \n    \n    <title>Email Already Registered</title>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css\" />\n\n    <style>\n        html, body {\n            height: 100%;\n        }\n\n        body {\n            background:\n                radial-gradient(circle at top left,#7c3aed 0%,transparent 40%),\n                radial-gradient(circle at bottom right,#2563eb 0%,transparent 40%),\n                linear-gradient(135deg,#0f172a,#111827,#1e293b);\n        }\n\n        .error-card {\n            width: 520px;\n            border-radius: 24px;\n            backdrop-filter: blur(18px);\n            background: rgba(255,255,255,.08);\n            border: 1px solid rgba(255,255,255,.15);\n            box-shadow: 0 25px 60px rgba(0,0,0,.35);\n        }\n\n        .error-icon {\n            width: 90px;\n            height: 90px;\n            margin: auto;\n            border-radius: 50%;\n            background: linear-gradient(135deg,#ef4444,#dc2626);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 42px;\n            color: white;\n            box-shadow: 0 12px 30px rgba(239,68,68,.4);\n        }\n\n        .title {\n            color: white;\n        }\n\n        .subtitle {\n            color: rgba(255,255,255,.75);\n            line-height: 1.7;\n        }\n\n        .notification {\n            background: rgba(239,68,68,.12);\n            border: 1px solid rgba(239,68,68,.35);\n            color: white;\n        }\n\n        .button.is-gradient {\n            background: linear-gradient(90deg,#7c3aed,#3b82f6);\n            color: white;\n            border: none;\n            font-weight: 700;\n            height: 48px;\n        }\n\n        .button.is-gradient:hover {\n            transform: translateY(-2px);\n        }\n\n        .button.is-light {\n            height: 48px;\n        }\n\n        a {\n            color: #93c5fd;\n        }\n    </style>\n</head>\n\n<body>\n\n<section class=\"hero is-fullheight\">\n    <div class=\"hero-body\">\n\n        <div class=\"container is-flex is-justify-content-center\">\n\n            <div class=\"card error-card\">\n\n                <div class=\"card-content has-text-centered p-6\">\n\n                    <div class=\"error-icon\">\n                        !\n                    </div>\n\n                    <h1 class=\"title is-2 mt-5\">\n                        Email Already Registered\n                    </h1>\n\n                    <p class=\"subtitle mt-4\">\n                        An account with this email address already exists.\n                        If it's your account, simply sign in. Otherwise,\n                        try registering with a different email address.\n                    </p>\n\n                    <div class=\"notification mt-5 has-text-left\">\n                        <strong>What would you like to do?</strong>\n\n                        <ul class=\"mt-3\">\n                            <li>• Sign in to your existing account.</li>\n                            <li>• Reset your password if you've forgotten it.</li>\n                            <li>• Register using another email address.</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"buttons mt-6\">\n                        <button class=\"button is-gradient is-fullwidth\">\n                            Sign In\n                        </button>\n\n                        <button class=\"button is-light is-fullwidth\">\n                            Reset Password\n                        </button>\n\n                        <button class=\"button is-fullwidth\">\n                            Try Another Email\n                        </button>\n                    </div>\n\n                    <p class=\"mt-5 has-text-white\">\n                        Need help?\n                        <a href=\"#\">Contact Support</a>\n                    </p>\n\n                </div>\n\n            </div>\n\n        </div>\n\n    </div>\n</section>\n\n</body>\n</html>"
