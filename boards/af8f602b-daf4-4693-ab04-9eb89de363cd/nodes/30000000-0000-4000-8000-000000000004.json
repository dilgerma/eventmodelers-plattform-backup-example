    "pages": [
      "\n<html lang=\"en\">\n<head>\n\n\n\n<title>Join The Movement</title>\n\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;700&family=Righteous&display=swap');\n\n    * {\n        box-sizing: border-box;\n    }\n\n    body {\n        margin: 0;\n        min-height: 100vh;\n        font-family: \"DM Sans\", sans-serif;\n        background: #f4e83d;\n        color: #20154f;\n        overflow-x: hidden;\n    }\n\n    /* =========================\n       BACKGROUND DECORATION\n       ========================= */\n\n    .page {\n        min-height: 100vh;\n        position: relative;\n        overflow: hidden;\n        padding: 40px;\n    }\n\n    .sunburst {\n        position: absolute;\n        width: 850px;\n        height: 850px;\n        top: -430px;\n        left: -380px;\n        border-radius: 50%;\n        background:\n            repeating-conic-gradient(\n                #ff5a36 0deg 12deg,\n                #f4e83d 12deg 24deg\n            );\n        z-index: 0;\n    }\n\n    .sunburst2 {\n        position: absolute;\n        width: 700px;\n        height: 700px;\n        bottom: -400px;\n        right: -350px;\n        border-radius: 50%;\n        background:\n            repeating-conic-gradient(\n                #42d9c8 0deg 10deg,\n                #ef3f78 10deg 20deg\n            );\n        z-index: 0;\n    }\n\n    .circle {\n        position: absolute;\n        border-radius: 50%;\n        z-index: 0;\n    }\n\n    .circle.one {\n        width: 130px;\n        height: 130px;\n        background: #ef3f78;\n        top: 8%;\n        right: 9%;\n    }\n\n    .circle.two {\n        width: 80px;\n        height: 80px;\n        background: #42d9c8;\n        bottom: 15%;\n        left: 8%;\n    }\n\n    .circle.three {\n        width: 45px;\n        height: 45px;\n        background: #20154f;\n        top: 35%;\n        left: 5%;\n    }\n\n    /* =========================\n       FLOWERS\n       ========================= */\n\n    .flower {\n        position: absolute;\n        width: 100px;\n        height: 100px;\n        z-index: 1;\n    }\n\n    .flower .petal {\n        position: absolute;\n        width: 45px;\n        height: 45px;\n        background: #ef3f78;\n        border-radius: 50%;\n    }\n\n    .flower .p1 { top: 0; left: 27px; }\n    .flower .p2 { top: 27px; right: 0; }\n    .flower .p3 { bottom: 0; left: 27px; }\n    .flower .p4 { top: 27px; left: 0; }\n\n    .flower .center {\n        position: absolute;\n        width: 38px;\n        height: 38px;\n        top: 31px;\n        left: 31px;\n        background: #f4e83d;\n        border: 5px solid #20154f;\n        border-radius: 50%;\n    }\n\n    .flower.a {\n        top: 18%;\n        left: 5%;\n        transform: rotate(-15deg);\n    }\n\n    .flower.b {\n        bottom: 10%;\n        right: 6%;\n        transform: rotate(20deg) scale(.8);\n    }\n\n    /* =========================\n       MAIN CONTENT\n       ========================= */\n\n    .content {\n        position: relative;\n        z-index: 5;\n        max-width: 1180px;\n        margin: auto;\n        display: grid;\n        grid-template-columns: 1fr 480px;\n        gap: 70px;\n        align-items: center;\n        min-height: calc(100vh - 80px);\n    }\n\n    /* =========================\n       LEFT SIDE\n       ========================= */\n\n    .intro {\n        padding: 30px;\n    }\n\n    .badge {\n        display: inline-block;\n        background: #20154f;\n        color: #f4e83d;\n        padding: 12px 22px;\n        border-radius: 40px;\n        font-family: \"Archivo Black\", sans-serif;\n        font-size: 13px;\n        letter-spacing: 2px;\n        transform: rotate(-3deg);\n        margin-bottom: 25px;\n        box-shadow: 6px 6px 0 #ef3f78;\n    }\n\n    h1 {\n        font-family: \"Righteous\", sans-serif;\n        font-size: clamp(70px, 8vw, 120px);\n        line-height: .82;\n        margin: 0;\n        letter-spacing: -3px;\n        color: #20154f;\n        text-transform: uppercase;\n    }\n\n    h1 span {\n        display: block;\n        color: #ef3f78;\n        -webkit-text-stroke: 2px #20154f;\n        text-shadow: 7px 7px 0 #f4e83d;\n    }\n\n    .intro p {\n        max-width: 530px;\n        font-size: 21px;\n        line-height: 1.5;\n        font-weight: 500;\n        margin: 35px 0;\n    }\n\n    .slogan {\n        display: inline-block;\n        background: #42d9c8;\n        padding: 15px 24px;\n        border: 4px solid #20154f;\n        font-family: \"Archivo Black\", sans-serif;\n        text-transform: uppercase;\n        transform: rotate(2deg);\n        box-shadow: 8px 8px 0 #20154f;\n    }\n\n    /* =========================\n       CARD\n       ========================= */\n\n    .card {\n        background: #fff7dc;\n        border: 6px solid #20154f;\n        border-radius: 35px;\n        padding: 38px;\n        box-shadow:\n            15px 15px 0 #ef3f78,\n            25px 25px 0 #20154f;\n        position: relative;\n    }\n\n    .card::before {\n        content: \"★\";\n        position: absolute;\n        top: -35px;\n        right: 25px;\n        font-size: 65px;\n        color: #ef3f78;\n        transform: rotate(15deg);\n        -webkit-text-stroke: 3px #20154f;\n    }\n\n    .card h2 {\n        font-family: \"Righteous\", sans-serif;\n        font-size: 42px;\n        margin: 0 0 8px;\n        text-transform: uppercase;\n    }\n\n    .card .sub {\n        margin: 0 0 28px;\n        color: #665f76;\n        font-size: 15px;\n    }\n\n    /* =========================\n       FORM\n       ========================= */\n\n    .field {\n        margin-bottom: 19px;\n    }\n\n    label {\n        display: block;\n        font-family: \"Archivo Black\", sans-serif;\n        font-size: 12px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        margin-bottom: 7px;\n    }\n\n    input {\n        width: 100%;\n        height: 54px;\n        border: 4px solid #20154f;\n        border-radius: 14px;\n        background: white;\n        padding: 0 16px;\n        font-family: \"DM Sans\", sans-serif;\n        font-size: 16px;\n        color: #20154f;\n        outline: none;\n    }\n\n    input:focus {\n        background: #f4e83d;\n        box-shadow: 5px 5px 0 #ef3f78;\n    }\n\n    .name-row {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 12px;\n    }\n\n    /* =========================\n       CHECKBOX\n       ========================= */\n\n    .terms {\n        display: flex;\n        gap: 10px;\n        align-items: flex-start;\n        margin: 22px 0;\n        font-size: 13px;\n        line-height: 1.4;\n    }\n\n    .terms input {\n        width: 20px;\n        height: 20px;\n        flex-shrink: 0;\n        margin-top: 1px;\n        accent-color: #ef3f78;\n    }\n\n    .terms a {\n        color: #ef3f78;\n        font-weight: 700;\n    }\n\n    /* =========================\n       BUTTON\n       ========================= */\n\n    button {\n        width: 100%;\n        height: 64px;\n        border: 5px solid #20154f;\n        border-radius: 18px;\n        background: #ef3f78;\n        color: white;\n        font-family: \"Archivo Black\", sans-serif;\n        font-size: 17px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        cursor: pointer;\n        box-shadow: 7px 7px 0 #20154f;\n        transition: .15s;\n    }\n\n    button:hover {\n        transform: translate(4px, 4px);\n        box-shadow: 3px 3px 0 #20154f;\n        background: #ff5a36;\n    }\n\n    /* =========================\n       LOGIN\n       ========================= */\n\n    .login {\n        text-align: center;\n        margin: 25px 0 0;\n        font-size: 14px;\n    }\n\n    .login a {\n        color: #ef3f78;\n        font-family: \"Archivo Black\", sans-serif;\n        text-decoration: none;\n    }\n\n    /* =========================\n       DECORATIVE TEXT\n       ========================= */\n\n    .floating-text {\n        position: absolute;\n        font-family: \"Righteous\", sans-serif;\n        text-transform: uppercase;\n        font-size: 45px;\n        color: #42d9c8;\n        -webkit-text-stroke: 2px #20154f;\n        transform: rotate(-12deg);\n        z-index: 2;\n    }\n\n    .floating-text.left {\n        bottom: 8%;\n        left: 22%;\n    }\n\n    .floating-text.right {\n        top: 13%;\n        right: 27%;\n        transform: rotate(10deg);\n        font-size: 30px;\n    }\n\n    /* =========================\n       RESPONSIVE\n       ========================= */\n\n    @media (max-width: 900px) {\n        .page {\n            padding: 20px;\n        }\n\n        .content {\n            grid-template-columns: 1fr;\n            gap: 40px;\n            padding: 30px 0;\n        }\n\n        .intro {\n            text-align: center;\n        }\n\n        .intro p {\n            margin-left: auto;\n            margin-right: auto;\n        }\n\n        .floating-text {\n            display: none;\n        }\n\n        .card {\n            max-width: 520px;\n            width: 100%;\n            margin: auto;\n        }\n\n        h1 {\n            font-size: 75px;\n        }\n    }\n\n    @media (max-width: 500px) {\n        .intro {\n            padding: 10px;\n        }\n\n        h1 {\n            font-size: 58px;\n        }\n\n        .intro p {\n            font-size: 17px;\n        }\n\n        .card {\n            padding: 27px 22px;\n            border-width: 5px;\n            box-shadow:\n                9px 9px 0 #ef3f78,\n                15px 15px 0 #20154f;\n        }\n\n        .card h2 {\n            font-size: 34px;\n        }\n\n        .name-row {\n            grid-template-columns: 1fr;\n            gap: 0;\n        }\n\n        .flower {\n            transform: scale(.65);\n        }\n    }\n</style>\n</head>\n\n<body>\n\n<div class=\"page\">\n\n    \n    <div class=\"sunburst\"></div>\n    <div class=\"sunburst2\"></div>\n\n    <div class=\"circle one\"></div>\n    <div class=\"circle two\"></div>\n    <div class=\"circle three\"></div>\n\n    \n    <div class=\"flower a\">\n        <div class=\"petal p1\"></div>\n        <div class=\"petal p2\"></div>\n        <div class=\"petal p3\"></div>\n        <div class=\"petal p4\"></div>\n        <div class=\"center\"></div>\n    </div>\n\n    <div class=\"flower b\">\n        <div class=\"petal p1\"></div>\n        <div class=\"petal p2\"></div>\n        <div class=\"petal p3\"></div>\n        <div class=\"petal p4\"></div>\n        <div class=\"center\"></div>\n    </div>\n\n    \n    <div class=\"floating-text left\">Groovy!</div>\n    <div class=\"floating-text right\">Good Vibes</div>\n\n    <main class=\"content\">\n\n        \n        <section class=\"intro\">\n\n            <div class=\"badge\">\n                ✦ WELCOME TO THE CLUB ✦\n            </div>\n\n            <h1>\n                JOIN\n                <span>THE</span>\n                PARTY\n            </h1>\n\n            <p>\n                Life is too short for boring software.\n                Create your account and step into a world\n                where ideas, creativity and good vibes\n                come together.\n            </p>\n\n            <div class=\"slogan\">\n                Make something wonderful ✌\n            </div>\n\n        </section>\n\n        \n        <section class=\"card\">\n\n            <h2>Sign Up!</h2>\n\n            <p class=\"sub\">\n                It only takes a minute. No funny business.\n            </p>\n\n            <form action=\"#\" method=\"post\">\n\n                <div class=\"name-row\">\n\n                    <div class=\"field\">\n                        <label for=\"first-name\">First Name</label>\n                        <input type=\"text\" id=\"first-name\" name=\"first_name\" placeholder=\"John\" required />\n                    </div>\n\n                    <div class=\"field\">\n                        <label for=\"last-name\">Last Name</label>\n                        <input type=\"text\" id=\"last-name\" name=\"last_name\" placeholder=\"Doe\" required />\n                    </div>\n\n                </div>\n\n                <div class=\"field\">\n                    <label for=\"email\">Email Address</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"john@example.com\" required />\n                </div>\n\n                <div class=\"field\">\n                    <label for=\"password\">Create Password</label>\n                    <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"Make it groovy...\" minlength=\"8\" required />\n                </div>\n\n                <div class=\"field\">\n                    <label for=\"password-confirm\">\n                        Confirm Password\n                    </label>\n                    <input type=\"password\" id=\"password-confirm\" name=\"password_confirm\" placeholder=\"One more time...\" minlength=\"8\" required />\n                </div>\n\n                <label class=\"terms\">\n                    <input type=\"checkbox\" name=\"terms\" required />\n\n                    <span>\n                        I agree to the\n                        <a href=\"#\">Terms of Service</a>\n                        and\n                        <a href=\"#\">Privacy Policy</a>.\n                        Let's make the world a little more colorful.\n                    </span>\n                </label>\n\n                <button type=\"submit\">\n                    Create My Account ★\n                </button>\n\n            </form>\n\n            <div class=\"login\">\n                Already part of the movement?\n                <a href=\"#\">Log in →</a>\n            </div>\n\n        </section>\n\n    </main>\n\n</div>\n\n</body>\n</html>"
